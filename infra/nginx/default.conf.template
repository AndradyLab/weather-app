server {
    listen 80;
    server_name ${NGIX_SERVER_NAME};
    resolver 8.8.8.8; # transforma o API_URL em ip
    
    location /v1/forecast {
        proxy_method GET;
        proxy_ssl_server_name on;
        proxy_pass ${API_URL}/forecast.json?key=${API_KEY}&$args&days=7;
    }
    location /v1/history {
        proxy_method GET;
        proxy_ssl_server_name on;
        proxy_pass ${API_URL}/history.json?key=${API_KEY}&$args;
    }
}